# Liner Platform API 키 (https://platform.liner.com/ko/keys 에서 발급)
# 키를 코드·문서·커밋에 넣지 마세요. 이 파일을 .env로 복사해 값을 채웁니다.
LINER_API_KEY=
LINER_BASE_URL=https://platform.liner.com/api/v1
# 대화·문장 작성 모델 (검증: liner-mark-1.3)
LINER_MODEL=liner-mark-1.3
# Liner 호출 타임아웃(초). Search Agent는 30~100초, Visualization은 20~30초 걸릴 수 있습니다.
LINER_TIMEOUT=120
# 웹 서버 포트 (로컬 전용 — Vercel은 PORT를 스스로 넣습니다)
PORT=8000
# 키 없이 규칙 기반으로만 돌리려면 1
LINER_OFFLINE=0
# Vercel 배포 시 위 값들을 대시보드 → Settings → Environment Variables 에 같은 이름으로 넣습니다.
# 사건 상태는 서버 메모리가 아니라 브라우저가 들고 다니는 state 토큰으로 이어지므로 별도 저장소 설정은 필요 없습니다.
